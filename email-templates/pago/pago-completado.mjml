<mjml lang="es">
  <mj-head>
    <mj-title>Recibimos tu pago en Medilo</mj-title>
    <mj-preview>Recibimos tu pago de $total. Tu factura $invoice_number va adjunta en PDF.</mj-preview>
    <mj-font name="Bricolage Grotesque" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Bricolage Grotesque', 'Trebuchet MS', 'Segoe UI', Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#2B346B" padding="0px" />
      <mj-image padding="0px" alt="" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
    </mj-attributes>
    <mj-style>
      .btn a { box-shadow:5px 5px 0 #16206B; }
      @media only screen and (max-width:480px) {
        .tagline { display:none !important; }
        .h1 { font-size:36px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ECEEF4" width="600px">

    <!-- Marca -->
    <mj-section padding="32px 0px 18px 0px">
      <mj-column width="60%">
        <mj-text font-size="30px" line-height="46px" font-weight="800" letter-spacing="-0.8px" color="#16206B"><img src="$asset_base_url/brand/logo.png" width="46" height="46" alt="Medilo" style="border:0;display:inline-block;vertical-align:middle;margin-right:10px;" />Medilo<span style="color:#FF7A1A;">.</span></mj-text>
      </mj-column>
      <mj-column width="230px" css-class="tagline">
        <mj-text align="right" font-size="13.5px" line-height="1.4" color="#4A5280">Plataforma oficial de gestión médica</mj-text>
      </mj-column>
    </mj-section>

    <!-- Tarjeta: borde navy; la banda naranja y la ola van como fondo -->
    <mj-wrapper
      border="2px solid #16206B"
      background-color="#FFFFFF"
      background-url="$asset_base_url/layout/band.png"
      background-size="84px 100%"
      background-repeat="no-repeat"
      background-position="left top"
      padding="0px"
    >
      <mj-section padding="0px">
        <mj-column>
          <mj-image src="$asset_base_url/layout/header.png" width="596px" height="132px" fluid-on-mobile="true" />
        </mj-column>
      </mj-section>

      <!-- Intención: etiqueta, título e ilustración de recibo con sello -->
      <mj-section padding="30px 34px 0px 84px">
        <mj-column width="62%" padding="0px 12px 0px 0px">
          <mj-text color="#16206B">
            <span style="display:inline-block;background:#FFF1E4;color:#16206B;border:2px solid #16206B;font-size:13.5px;font-weight:700;padding:3px 12px;margin-bottom:16px;">Pago confirmado</span>
            <div class="h1" style="font-size:40px;line-height:1.02;font-weight:800;letter-spacing:-1.4px;color:#16206B;">Recibimos<br>tu pago.</div>
            <div style="margin-top:16px;font-size:16px;line-height:1.5;color:#4A5280;">Hola $first_name. Tu factura va adjunta en PDF a este correo.</div>
          </mj-text>
        </mj-column>
        <mj-column width="38%" padding="6px 0px 0px 0px">
          <mj-image src="$asset_base_url/illustrations/recibo-pago.png" width="140px" height="140px" alt="Recibo con un sello de pago confirmado" align="right" />
        </mj-column>
      </mj-section>

      <!-- Datos del pago -->
      <mj-section padding="26px 34px 0px 84px">
        <mj-column>
          <mj-text>
            <div style="background:#FFF1E4;border:2px solid #16206B;box-shadow:5px 5px 0 #16206B;padding:18px 20px;">
              <div style="font-size:13.5px;color:#4A5280;">Factura</div>
              <div style="font-size:17px;font-weight:700;color:#16206B;margin-bottom:12px;">$invoice_number</div>
              <div style="font-size:13.5px;color:#4A5280;">Total pagado</div>
              <div style="font-size:17px;font-weight:700;color:#16206B;">$total</div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Llamada a la acción -->
      <mj-section padding="30px 34px 0px 84px">
        <mj-column>
          <mj-text>
            <p style="margin:0;">Tu factura también está disponible para descargar en PDF. El enlace caduca en 7 días.</p>
          </mj-text>
          <mj-button href="$download_url" align="left" background-color="#FF7A1A" color="#16206B" font-size="18px" font-weight="800" letter-spacing="-0.2px" border="2px solid #16206B" border-radius="0px" inner-padding="17px 38px" padding="28px 0px 0px 0px" css-class="btn">
            Descargar factura PDF
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Letra pequeña -->
      <mj-section padding="30px 34px 28px 84px">
        <mj-column>
          <mj-text padding="0px" font-size="13px" line-height="1.6" color="#4A5280">
            <p style="margin:0;">Este mensaje se genera de forma automática, por favor no respondas a este correo.</p>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Datos de la unidad médica -->
      <mj-section background-color="#FFF1E4" border-top="2px solid #16206B">
        <mj-column padding="22px 28px">
          <mj-text font-size="15px" line-height="1.3" font-weight="800" color="#16206B">Medilo</mj-text>
          <mj-text font-size="13.5px" line-height="1.65" color="#2B346B" padding="6px 0px 0px 0px">
            Av. Los Andes y Mera, Ambato, Tungurahua<br>Atención: lunes a viernes, 8:00 a 17:00<br>Teléfono: (03) 282-4567
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Pie -->
    <mj-section padding="26px 8px 0px 8px">
      <mj-column>
        <mj-text align="center" font-size="12.5px" line-height="1.65" color="#4A5280" padding="0px 20px">
          Medilo cumple con los estándares de confidencialidad de información en salud.<br>&copy; 2026 Medilo Inc. Todos los derechos reservados.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
