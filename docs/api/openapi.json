{"components":{"schemas":{"Appointment":{"properties":{"estado":{"enum":["PENDIENTE_PAGO","CONFIRMADA","COMPLETADA","CANCELADA","EXPIRADA","NO_ASISTIO"],"type":"string"},"expiracion_reserva":{"format":"date-time","type":["string","null"]},"horario_id":{"format":"uuid","type":"string"},"id":{"format":"uuid","type":"string"},"motivo":{"maxLength":500,"type":["string","null"]},"servicio_id":{"format":"uuid","type":"string"}},"required":["id","estado","horario_id","servicio_id","motivo","expiracion_reserva"],"type":"object"},"AvailabilityResponse":{"properties":{"items":{"items":{"$ref":"#/components/schemas/AvailableSlot"},"type":"array"}},"required":["items"],"type":"object"},"AvailableSlot":{"properties":{"fin_utc":{"format":"date-time","type":"string"},"horario_id":{"format":"uuid","type":"string"},"inicio_utc":{"format":"date-time","type":"string"},"medico_id":{"format":"uuid","type":"string"}},"required":["horario_id","medico_id","inicio_utc","fin_utc"],"type":"object"},"BookAppointmentRequest":{"additionalProperties":false,"properties":{"horario_id":{"format":"uuid","title":"Horario Id","type":"string"},"motivo":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"default":null,"title":"Motivo"},"servicio_id":{"format":"uuid","title":"Servicio Id","type":"string"}},"required":["horario_id","servicio_id"],"title":"BookAppointmentRequest","type":"object"},"CreateUserRequest":{"additionalProperties":false,"properties":{"email":{"maxLength":255,"minLength":3,"title":"Email","type":"string"},"first_name":{"maxLength":100,"minLength":1,"title":"First Name","type":"string"},"last_name":{"maxLength":100,"minLength":1,"title":"Last Name","type":"string"},"password":{"maxLength":256,"minLength":12,"title":"Password","type":"string"},"roles":{"items":{"type":"string"},"maxItems":4,"minItems":1,"title":"Roles","type":"array"}},"required":["email","password","first_name","last_name","roles"],"title":"CreateUserRequest","type":"object"},"LoginRequest":{"additionalProp