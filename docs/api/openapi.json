em"}}},"description":"Appointment can no longer be cancelled"}},"security":[{"bearerAuth":[]}],"summary":"Cancel an own appointment and release its slot","tags":["Scheduling"]}},"/api/v1/auth/login":{"post":{"description":"Returns a short-lived bearer token. Unknown emails and wrong passwords return the same problem.","operationId":"login","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginRequest"}}},"required":true},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginResponse"}}},"description":"Token issued"},"401":{"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}},"description":"Invalid credentials"},"422":{"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}},"description":"Invalid request body"}},"summary":"Sign in with email and password","tags":["Identity"]}},"/api/v1/availability":{"get":{"description":"Only slots that have not started are returned. The window can be at most 31 days long.","operationId":"listAvailability","parameters":[{"description":"Window start, ISO-8601 with timezone offset","in":"query","name":"desde","required":true,"schema":{"format":"date-time","type":"string"}},{"description":"Window end, ISO-8601 with timezone offset (after 'desde')","in":"query","name":"hasta","required":true,"schema":{"format":"date-time","type":"string"}},{"description":"Optional: only slots of this clinician","in":"query","name":"medico_id","required":false,"schema":{"format":"uuid","type":"string"}}],"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AvailabilityResponse"}}},"description":"Free slots"},"401":{"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}},"description":"Missing, malformed or inactive credentials"},"403":{"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}},"description":"