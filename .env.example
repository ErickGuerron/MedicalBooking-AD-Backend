APP_ENV=local
#En produccion se debe desactivar esta opcion
API_DOCS_ENABLED=true

#Configuracion de base de datos SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=MedicalBooking
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
JWT_SIGNING_KEY=

#Email Service
BREVO_API_KEY=
# Remitente verificado en Brevo.
MAIL_FROM=
MAIL_FROM_NAME=

# Imagenes de los correos (bucket publico de Supabase Storage, sin secretos)
# URL base del bucket, sin barra final.
EMAIL_ASSETS_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/email-assets/email-templates/assets

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Stripe (E4 payments). Test keys locally, live keys only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_... locally). Public: the browser mounts the embedded checkout with it.
STRIPE_PUBLISHABLE_KEY=


#Urls Frontends
FLUTTER_FRONT_URL=http://localhost:8081
ANGULAR_FRONT_URL=http://localhost:4200
